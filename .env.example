# Copy to .env.local and fill in. Never commit .env.local.

# Final site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: set to save contact form leads to MongoDB Atlas
MONGODB_URI=

# Optional analytics (mention in Privacy Policy if used)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
