# Copy to .env.local and fill in. Never commit .env.local.
# Everything except MONGODB_URI, SESSION_SECRET and the seed admin has a working mock default.

# ── App ──────────────────────────────────────────────
# Public base URL (canonical URLs, sitemap, payment callbacks, links in emails)
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/oxford-vale
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oxford-vale?retryWrites=true&w=majority
MONGODB_URI=

# ── Security ─────────────────────────────────────────
# Long random strings. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Bearer token for /api/cron/abandoned-carts (Vercel Cron sends it automatically when set as CRON_SECRET)
CRON_SECRET=

# ── Seed (npm run seed) ──────────────────────────────
SEED_ADMIN_EMAIL=owner@oxfordvale.example
SEED_ADMIN_PASSWORD=
# Password for the demo Manager and Staff accounts (defaults to SEED_ADMIN_PASSWORD)
SEED_DEMO_PASSWORD=

# ── Email ────────────────────────────────────────────
# log  = print to console + save in admin → Messages (no email sent)
# smtp = send through the SMTP server below (any provider: Gmail/Workspace app password, Zoho, Brevo, Mailgun SMTP…)
# Port 465 uses TLS; 587 uses STARTTLS. Test it from admin → Settings → Email & payments.
EMAIL_PROVIDER=log
EMAIL_FROM="Oxford Vale <hello@oxfordvale.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Payments: Stripe (cards, Amex, Apple Pay, Google Pay, Klarna) ──
# Empty = mock mode: a built-in test page, no account needed.
# sk_test_… = Stripe test mode (free: https://dashboard.stripe.com/test/apikeys); sk_live_… = real payments.
# Turn on Apple Pay, Google Pay and Klarna under Settings → Payment methods in the Stripe dashboard.
STRIPE_SECRET_KEY=
# Webhook (needed for Klarna and other delayed payments): endpoint https://<your-domain>/api/payments/stripe/webhook,
# events checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed.
# Locally: stripe listen --forward-to localhost:3000/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ── Payments: PayPal ─────────────────────────────────
# Empty = mock mode. Sandbox app keys: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default when keys are set) | live
PAYPAL_MODE=sandbox

# ── Storage for admin image uploads ──────────────────
# local = storage/uploads/, served at /uploads/... (fine for local dev and a VPS; Vercel needs a cloud provider)
STORAGE_PROVIDER=local

# ── Product photo script (npm run images) ────────────
# One free key is enough. Pixabay: https://pixabay.com/api/docs/ (key shown after free sign-up)
# Pexels: https://www.pexels.com/api/ · Unsplash: https://unsplash.com/developers
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
