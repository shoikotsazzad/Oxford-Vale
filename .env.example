# Copy to .env.local and fill in. Never commit .env.local.
# Everything except MONGODB_URI, SESSION_SECRET and the seed admin has a working mock default.

# ── App ──────────────────────────────────────────────
# Public base URL (canonical URLs, sitemap, payment callbacks, links in emails)
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/oxford-vale
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oxford-vale?retryWrites=true&w=majority
MONGODB_URI=

# ── Security ─────────────────────────────────────────
# Long random strings. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Bearer token for /api/cron/abandoned-carts (Vercel Cron sends it automatically when set as CRON_SECRET)
CRON_SECRET=

# ── Seed (npm run seed) ──────────────────────────────
SEED_ADMIN_EMAIL=owner@oxfordvale.example
SEED_ADMIN_PASSWORD=
# Password for the demo Manager and Staff accounts (defaults to SEED_ADMIN_PASSWORD)
SEED_DEMO_PASSWORD=

# ── Email ────────────────────────────────────────────
# log  = print to console + save in admin → Messages (no email sent)
# smtp = send through the SMTP server below (any provider: Gmail/Workspace app password, Zoho, Brevo, Mailgun SMTP…)
# Port 465 uses TLS; 587 uses STARTTLS. Test it from admin → Settings → Email & SMS.
EMAIL_PROVIDER=log
EMAIL_FROM="Oxford Vale <hello@oxfordvale.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS ──────────────────────────────────────────────
# log | sslwireless | bulksmsbd. Order placed and shipped send an SMS to the customer.
SMS_PROVIDER=log
# SSL Wireless ISMS (API v3): token + SID (masking or non-masking) from your SSL Wireless account
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
# BulkSMSBD: API key + approved sender ID from bulksmsbd.net
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# ── Payments: SSLCommerz ─────────────────────────────
# mock    = built-in fake gateway page, no account needed
# sandbox = https://sandbox.sslcommerz.com (free developer store: https://developer.sslcommerz.com/registration/)
# live    = real payments
SSLCOMMERZ_MODE=mock
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ── Storage for admin image uploads ──────────────────
# local = storage/uploads/, served at /uploads/... (fine for local dev and a VPS; Vercel needs a cloud provider)
STORAGE_PROVIDER=local

# ── Product photo script (npm run images) ────────────
# One free key is enough. Pixabay: https://pixabay.com/api/docs/ (key shown after free sign-up)
# Pexels: https://www.pexels.com/api/ · Unsplash: https://unsplash.com/developers
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
